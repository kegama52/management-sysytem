# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5324/tiisgs_db

# JWT
JWT_SECRET=tiisgs-super-secret-key-change-in-production-2024

# AI Integration (optional)
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=https://api.example.com/v1/chat

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@nationaltreasury.go.ke
SMTP_PASS=your_smtp_password

# PKI Integration (optional - for Government CA)
PKI_CA_URL=https://pki.ictauthority.go.ke/api
PKI_CERT_PATH=/path/to/ca-cert.pem